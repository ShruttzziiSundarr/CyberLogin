# ---------------------------------------------------------------------------
# sso-lab — example environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Portal (backend) ---
PORT=4000
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# Seed admin account for local dev (session-based login, not hardcoded in code)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- PingFederate admin API ---
PF_ADMIN_BASE_URL=https://localhost:9999/pf-admin-api/v1
PF_ADMIN_USER=administrator
PF_ADMIN_PASSWORD=change-me
# Alternative to basic auth: OAuth2 bearer token flow
PF_ADMIN_AUTH_MODE=basic
PF_ADMIN_OAUTH_TOKEN_URL=
PF_ADMIN_OAUTH_CLIENT_ID=
PF_ADMIN_OAUTH_CLIENT_SECRET=

# NEVER set true in production. Self-signed dev cert only.
PF_TLS_INSECURE=false

# When true, all PingFederate admin API calls are served by an in-memory mock
# so the whole portal runs standalone as a demo, with no real PingFederate
# required. Never enable in production.
MOCK_PING=true

# --- PingFederate runtime (what end users hit) ---
PF_RUNTIME_BASE_URL=https://localhost:9031

# --- PingDirectory (guided data store creation, optional) ---
PD_LDAP_HOST=localhost:1389
PD_BIND_DN=cn=Directory Manager
PD_BIND_PASSWORD=change-me
PD_SEARCH_BASE=ou=people,dc=example,dc=com

# --- Feature flags ---
# MFA policy wiring is the highest-risk operation in the app. Off by default.
FEATURE_MFA_POLICY_WRITE=false

# --- This app as a SAML 2.0 Service Provider (PingFederate is the IdP) ---
# Public URL this backend is reachable at; used to build ACS/metadata/SLO URLs.
SP_BASE_URL=http://localhost:4000
# Where the browser is sent back to after ACS finishes processing the assertion.
FRONTEND_BASE_URL=http://localhost:5173
SP_ENTITY_ID=urn:sso-lab:sp
# SP signing/decryption keypair. A dev pair is generated at backend/certs/ (gitignored).
# Regenerate with:
#   openssl req -x509 -newkey rsa:2048 -keyout backend/certs/sp-private-key.pem \
#     -out backend/certs/sp-certificate.pem -days 3650 -nodes -subj "/CN=unified-login-onboarding-portal-sp"
SP_PRIVATE_KEY_PATH=certs/sp-private-key.pem
SP_CERTIFICATE_PATH=certs/sp-certificate.pem
# In deployments where backend/certs/ isn't shipped (e.g. Render), paste the PEM
# contents directly instead — these win over the *_PATH values above when set.
SP_PRIVATE_KEY=
SP_CERTIFICATE=

# PingFederate, acting as the IdP for this SP. Get these after importing this
# app's metadata (GET /api/saml/metadata) into PingFederate as a new SP
# Connection: Applications > Integration > SP Connections > Create Connection.
PF_IDP_ENTITY_ID=
PF_IDP_SSO_URL=
PF_IDP_SLO_URL=
PF_IDP_CERT=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:4000/api
